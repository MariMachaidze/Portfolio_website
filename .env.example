# Copy this file to .env for local `netlify dev` testing.
# Real values are never committed — they live only in this file locally
# (gitignored) and in Netlify's dashboard (Site settings > Environment variables)
# for production. None of these should ever be prefixed VITE_, since that
# prefix is what Vite inlines into the public client bundle.

# --- Phase 1: Admin auth (password + TOTP) ---
ADMIN_PASSWORD_HASH=
TOTP_SECRET=
SESSION_JWT_SECRET=

# --- Phase 2: GitHub content commits ---
GITHUB_TOKEN_ADMIN=
GITHUB_OWNER=
GITHUB_REPO=
ALLOW_LOCAL_GIT_WRITES=false

# --- Phase 3: S3 image uploads ---
# Not AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY: those names are reserved by
# Netlify because Functions run on AWS Lambda, which injects its own values
# under those exact names.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=

# --- GitHub contribution graph (public homepage widget) ---
# Deliberately a separate, scopeless/read-only token — NOT GITHUB_TOKEN_ADMIN —
# since this powers a publicly-invocable, unauthenticated function.
GITHUB_TOKEN_PUBLIC=
GITHUB_ACTIVITY_USERNAME=
